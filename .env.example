# ==============================================================================
# Application Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# DO NOT commit sensitive credentials or real secrets to version control.
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Server Network Configuration
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@localhost:5432/tourism_insider?schema=public"

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
CORS_CREDENTIALS=true

# Request Body Limit
BODY_LIMIT=1mb
